rules_version = '2';
// Wuanberri: each signed-in account can read and write only its own document.
// Nothing else in the database is reachable from the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 't'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000
        && request.resource.data.t is int;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
